## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Visual Studio 2017 cache/options directory
.vs/

# Rider generated files
.idea/
*.sln.iml

# Visual Studio Code generated files
.vscode/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-agent*.log
nunit-console*.log

# Build Results of an ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# Benchmark Results
BenchmarkDotNet.Artifacts/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# StyleCop
StyleCop.Cache
stylecop.json

# FxCop
FxCop.mismatch

# Roslyn Analyzers
*.ruleset

# ReSharper is a .NET developer productivity extension for Microsoft Visual Studio
# Learn more about it at https://www.jetbrains.com/resharper/
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# TeamCity is a build management and continuous integration server from JetBrains
_TeamCity*

# DotCover is a .NET code coverage tool
*.dotCover

# AxoCover is a free code coverage extension for VS
.axoCover/*
!.axoCover/settings.json

# Coverlet is a cross platform code coverage library for .NET
coverage.cobertura.xml
coverage.json

# Visual Studio code coverage results
*.coverage
*.coveragexml

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# MightyMoose
*.mm.*
AutoTest.Net/

# SpecFlow
*.feature.cs

# Paket dependency manager
.paket/paket.exe
paket-files/

# FAKE - F# Make
.fake/

# CodeRush
.cr/

# Python Tools for Visual Studio (PTVS)
__pycache__/
*.pyc

# Cake - (C# Make)
tools/

# Tabs Studio
*.tss

# Telerik's JustMock configuration file
*.jmconfig

# BizTalk build output
*.btp.cs
*.btm.cs
*.odx.cs
*.xsd.cs

# BizTalk EDI/AS2 Stuff
EdiSchemas/
AS2Schemas/
PartyData/

# Visual Studio Profiler
*.psess
*.vsp
*.vspx
*.sap

# Visual Studio Trace Files
*.e2e

# NCover
*.ncover
*.coveragedb

# Service Fabric
[Aa]pplication[Pp]ackage[Rr]oot/
[Aa]pplication[Pp]arameters/

# Deployment project files
*.deployproj

# Deployment cab project files
*.ddf
*.cab

# ClickOnce
publish/

# Docker
docker-compose.yml.override
.dockerignore

# Microsoft Azure Service Fabric Composer generated files
.sfproj.user

# SonarQube/SonarCloud
.sonarlint/
.sonarqube/

# Bridge.NET
www/

# ILRepack
ILRepack.List

# Netlify
.netlify

# Nuget
*.nupkg
# NuGet symbol packages
*.snupkg

# Test files
*.testsettings

# Visual Studio building extension
*.vsix
*.vsixmanifest

# Windows Installer XML Toolset
*.wixproj.user

# Tizen
tizen-manifest.xml

# Built files from Rider
*/bin
*/obj

# Azure Functions
.azurefunctions/
.funcignore

# JetBrains Rider
.idea/

# Mac/Linux
*.swp

# Env files
.env

# Ignore files from the root of the project
/packages
/src/packages

# Terraform
.terraform/
*.tfstate
*.tfstate.*.backup
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
obj/
bin/

**/bin/
**/obj/
*.cache